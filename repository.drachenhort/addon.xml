<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="repository.drachenhort"
       name="drachenhort Kodi Addons"
       version="1.0.0"
       provider-name="drachenhort">
  <extension point="xbmc.addon.repository" name="drachenhort Kodi Addons">
    <dir>
      <info compressed="false">https://drachenhort.github.io/drachenhort-repo/addons.xml</info>
      <checksum>https://drachenhort.github.io/drachenhort-repo/addons.xml.md5</checksum>
      <datadir zip="true">https://drachenhort.github.io/drachenhort-repo/</datadir>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Repository for drachenhort's Kodi addons</summary>
    <description lang="en_GB">
      Install this once to let Kodi automatically discover and install updates
      for Twitch Center and Jellyfin (Plex-style).
    </description>
    <platform>all</platform>
    <license>MIT</license>
    <assets>
      <icon>icon.png</icon>
    </assets>
  </extension>
</addon>
